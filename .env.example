# E-Voting HIMA - Environment Configuration
# Copy file ini menjadi .env dan isi dengan nilai asli dari Netlify dashboard

# Supabase (dari Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Password login panitia (admin)
ADMIN_PASSWORD=your-strong-admin-password

# Token signing secret - generate dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=your-random-32-char-hex-secret
